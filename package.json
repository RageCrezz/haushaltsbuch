{
  "name": "haushaltsbuch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "dev:next": "next dev -p 3333",
    "dev": "npm run prisma:generate && npm run db:push && npm run dev:next",
    "dev:e2e": "ENABLE_E2E_TESTS=true NEXT_DIST_DIR=/tmp/haushaltsbuch-e2e next dev -p 3334",
    "build": "npm run prisma:generate && next build",
    "start": "next start -p 3333",
    "lint": "eslint",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test \"npm run dev:e2e\" http://localhost:3334 \"npm run cypress:run\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "next": "16.2.0",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^15.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
