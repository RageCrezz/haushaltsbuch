generator client {
  provider = "prisma-client"
  output   = "generated/runtime-client"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseType {
  EXPENSE
  INCOME
}

model User {
  id                           String      @id @default(cuid())
  email                        String      @unique
  name                         String
  passwordHash                 String
  emailVerifiedAt              DateTime?
  emailVerificationToken       String?     @unique
  emailVerificationExpiresAt   DateTime?
  salaryCents                  Int         @default(0)
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt
  expenses                     Expense[]
  fixedCosts                   FixedCost[]
  sessions                     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FixedCost {
  id          String   @id @default(cuid())
  name        String
  amountCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Expense {
  id          String   @id @default(cuid())
  name        String
  amountCents Int
  type        ExpenseType @default(EXPENSE)
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expenseDate])
}
